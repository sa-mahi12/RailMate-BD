<?xml version="1.0" encoding="utf-8"?>
<!-- P02: RailMate BD native launch window. Deep-teal plate with the centred
     brand mark so the cold-start window matches the Flutter splash instead of
     the default white template. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/railmate_teal" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
