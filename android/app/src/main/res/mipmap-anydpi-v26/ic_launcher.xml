<?xml version="1.0" encoding="utf-8"?>
<!-- P02: RailMate BD adaptive launcher icon. Background is the brand deep
     teal plate; the foreground keeps the train mark inside the 72dp safe
     zone so no launcher mask crops it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/railmate_teal" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
